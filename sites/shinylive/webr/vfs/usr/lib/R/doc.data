// Used in tools:::.make_KaTeX_checker().
function checkTex(s)
{
    var opts = { throwOnError: true, macros: macros };
    var out = { error: "", warnings: [] };
    try {
	console.warn = function(w) { out.warnings.push(w); };
	katex.renderToString(s, opts);
    } catch (e) {
	out.error = e.message;
    };
    return out;
}

const macros = {
    "\\R": "\\textsf{R}",
    "\\mbox": "\\text",
    "\\code": "\\texttt"
};

function processMathHTML()
{
    var i, l = document.getElementsByClassName('reqn');
    var opts = { throwOnError: false, macros: macros };
    for (i = 0; i < l.length; i++) {
	katex.render(l[i].textContent, l[i], opts);
    }
    return;
}


